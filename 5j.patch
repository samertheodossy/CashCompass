+/** Keep durable receipts small: no workbook ids, names, URLs, or financial values. */
+function harnessBuildSuiteEvidence_(report) {
+  var scenarios = report && Array.isArray(report.scenarios)
+    ? report.scenarios
+    : [];
+  var cleanupRequested = false;
+  var cleanupVerified = scenarios.length > 0;
+  for (var i = 0; i < scenarios.length; i++) {
