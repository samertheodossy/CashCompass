+    var cleanup = full && full.cleanup;
+    if (cleanup && cleanup.requested === true) cleanupRequested = true;
+    if (!cleanup || cleanup.requested !== true ||
+        cleanup.trashed !== true || cleanup.verified !== true ||
+        cleanup.error) {
+      cleanupVerified = false;
+    }
+  }
+  return {
+    version: 1,
+    type: 'harnessSuiteEvidence',
+    suiteId: report && report.suite ? report.suite.id : '',
+    runId: report ? report.runId : '',
+    overall: report ? report.overall : 'FAIL',
+    startedAt: report ? report.startedAt : null,
+    finishedAt: report ? report.finishedAt : null,
+    durationMs: report ? report.durationMs : null,
+    counts: report ? report.counts : null,
+    assertions: report ? report.assertions : null,
+    cleanup: {
+      requested: cleanupRequested,
+      trashed: cleanupVerified,
+      verified: cleanupVerified
+    },
+    phase: 'COMPLETE',
+    errors: scenarios.filter(function(item) {
+      return item && item.error;
+    }).map(function(item) {
+      return {
+        scenarioId: String(item.id || ''),
+        error: String(item.error || '').slice(0, 300)
+      };
+    }).slice(0, 5)
+  };
